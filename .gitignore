# KiCad - fichiers locaux et sauvegardes
*.kicad_prl
*-backups/
*.bak
*.kicad_sch-bak
*.kicad_pcb-bak
_autosave-*
fp-info-cache

# Rapports regeneres a la demande (kicad/ et ses sous-dossiers, ex. fd-autoplacer-experiment/)
kicad/erc.rpt
kicad/drc-*.rpt
kicad/autoroute-apres-drc.rpt
kicad/compact-*.rpt
kicad/avant-*.rpt
kicad/**/*.xml
kicad/**/*_drc_violations.json

# Historique local KiCad (depot git interne de recup de fichiers)
kicad/.history/

# Fichiers intermediaires de l'autorouteur (Freerouting)
kicad/**/*.dsn
kicad/**/*.ses

# Verrous poses par KiCad quand le projet est ouvert
~*.lck

# Etat interne Claude Code (sans rapport avec le projet)
.claude/
